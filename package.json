{
  "name": "gariseba-mern",
  "version": "2.3.0",
  "private": true,
  "description": "Bilingual vehicle help and roadside request management for Dhaka",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "dev": "concurrently --kill-others --names API,WEB \"node --watch src/server.js\" \"vite --host 127.0.0.1\"",
    "build": "vite build",
    "start": "node src/server.js",
    "seed": "node scripts/seed.js",
    "create-admin": "node scripts/create-admin.js",
    "import:sqlite": "node --experimental-sqlite scripts/import-sqlite.js",
    "backup": "node scripts/backup.js",
    "test": "node --experimental-sqlite --test test/logic.test.js test/integration.test.js test/operations.test.js",
    "test:unit": "node --test test/logic.test.js"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/noto-sans-bengali": "^5.3.0",
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.70.0",
    "mongodb": "^6.22.0",
    "multer": "^2.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.5",
    "tailwindcss": "^4.3.5",
    "vite": "^7.3.8"
  }
}
