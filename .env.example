# Run npm run setup once to create .env with random secrets.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=gariseba
PUBLIC_BASE_URL=http://localhost:3000
# Only set a positive hop count behind a reverse proxy that overwrites forwarded headers.
TRUST_PROXY_HOPS=0
SESSION_SECRET=generate-with-setup
IP_HASH_SALT=generate-with-setup

# Existing project contact. Verify it before opening the site to customers.
WHATSAPP_NUMBER=8801608095085

# Optional. Use openai or anthropic and a model your provider account can access.
# Keep credentials here or in your hosting platform's environment, never in web/.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Optional ClamAV daemon. Keep the daemon on a private network.
CLAMAV_HOST=
CLAMAV_PORT=3310
